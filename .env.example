# ProcureFlow OSS Environment Configuration
# Copy this file to .env and adjust values for your environment

# App Configuration
PROCUREFLOW_ENV=development
PROCUREFLOW_DEBUG=true
PROCUREFLOW_SECRET_KEY=dev_secret_key_change_in_production_32chars_min
PROCUREFLOW_API_KEY=procureflow_dev_api_key_12345
PROCUREFLOW_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database (PostgreSQL)
# For local dev without Docker, SQLite fallback is supported: sqlite+aiosqlite:///./procureflow.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/procureflow
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/procureflow

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# In test or local dev without Redis, set CELERY_ALWAYS_EAGER=true
CELERY_ALWAYS_EAGER=false

# File Storage
# Implemented backend: local
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/storage
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 MB

# Document interpretation and narrative provider configuration
# Provider options: openai | anthropic | ollama | mock
# NOTE: 'mock' is strictly for development, testing, and offline demos;
# it is strictly prohibited and blocked when PROCUREFLOW_ENV=production.
PROCUREFLOW_LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Providers
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# For Docker Desktop; use http://localhost:11434 when running Python on the host.
# Linux containers need a reachable hostname or a host-gateway mapping.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# Reserved exchange-rate configuration (not connected to normalization)
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest
